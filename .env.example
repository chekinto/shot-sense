# Template only — no real secrets in this file (it is committed).
# Copy to .env  (git-ignored) and fill in from your Supabase project.
# Use ".env", not ".env.local": the Prisma CLI only reads ".env", and Next.js
# reads it too, so one file covers both.
#
#   Supabase dashboard → Connect → ORMs → Prisma   (DATABASE_URL + DIRECT_URL)
#   Settings → API                                 (Project URL + anon key)

# --- Supabase Auth (public — inlined into the browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# --- Postgres for Prisma ---
# Copy BOTH lines verbatim from: dashboard -> Connect -> ORMs -> Prisma, then
# replace [YOUR-PASSWORD]. Do not hand-edit the host — the "aws-0-" / "aws-1-"
# prefix and region must match your project exactly or the pooler returns
# "Tenant or user not found".
#   DATABASE_URL = Transaction pooler, port 6543, ?pgbouncer=true (+ &connection_limit=1)
#   DIRECT_URL   = Session pooler,     port 5432
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"
