// Shot Sense — persistence schema.
// Prisma is infrastructure only. Prisma-generated types never enter src/domain;
// infrastructure/prisma/mappers converts rows <-> domain shapes.
//
// Auth boundary: Prisma connects through the Supabase pooler with a privileged
// role, so Postgres RLS does not constrain it. The repository layer is the
// enforcement boundary — every method filters by the authenticated user id.
// RLS is still enabled on every table as a backstop for direct DB access.
// See src/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) — runtime
  directUrl = env("DIRECT_URL") // direct — migrations / introspection
}

/// Application profile for a Supabase Auth user. One row per auth.users.id.
/// Auth credentials live in Supabase Auth and are never duplicated here (§77).
model Profile {
  /// Supabase Auth user id (auth.users.id).
  userId String @id @map("user_id") @db.Uuid

  /// Playing handicap, e.g. 12.4. Null until the user completes onboarding.
  handicap Decimal? @db.Decimal(4, 1)

  /// Scoring Zone the user defaults to. Fixed at 100 in V1 (kept for a future
  /// configurable zone); never surfaced in onboarding.
  defaultScoringZoneYards Int @default(100) @map("default_scoring_zone_yards")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

/// A private, user-created golf course (§13, §78). No shared/community data in V1.
model GolfCourse {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  name      String
  /// 9 or 18 (validated in the application layer).
  holeCount Int    @map("hole_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  holes   CourseHole[]
  teeSets TeeSet[]

  @@index([userId, name])
  @@map("golf_courses")
}

/// Par for one hole of a course (§79). Par belongs to the course hole; yardage
/// belongs to the tee/hole combination.
model CourseHole {
  id         String @id @default(uuid()) @db.Uuid
  courseId   String @map("course_id") @db.Uuid
  holeNumber Int    @map("hole_number")
  par        Int

  course      GolfCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teeYardages TeeHoleYardage[]

  @@unique([courseId, holeNumber])
  @@map("course_holes")
}

/// A set of tees for a course, e.g. White / Yellow / Red (§15, §80).
model TeeSet {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  name     String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course   GolfCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  yardages TeeHoleYardage[]

  @@unique([courseId, name])
  @@map("tee_sets")
}

/// Yardage for one hole from one tee set (§81). Optional in V1.
model TeeHoleYardage {
  id           String @id @default(uuid()) @db.Uuid
  teeSetId     String @map("tee_set_id") @db.Uuid
  courseHoleId String @map("course_hole_id") @db.Uuid
  yardage      Int

  teeSet     TeeSet     @relation(fields: [teeSetId], references: [id], onDelete: Cascade)
  courseHole CourseHole @relation(fields: [courseHoleId], references: [id], onDelete: Cascade)

  @@unique([teeSetId, courseHoleId])
  @@map("tee_hole_yardages")
}
