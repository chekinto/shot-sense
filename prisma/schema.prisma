// Shot Sense — persistence schema.
// Prisma is infrastructure only. Prisma-generated types never enter src/domain;
// infrastructure/prisma/mappers converts rows <-> domain shapes.
//
// Auth boundary: Prisma connects through the Supabase pooler with a privileged
// role, so Postgres RLS does not constrain it. The repository layer is the
// enforcement boundary — every method filters by the authenticated user id.
// RLS is still enabled on every table as a backstop for direct DB access.
// See src/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) — runtime
  directUrl = env("DIRECT_URL") // direct — migrations / introspection
}

/// Application profile for a Supabase Auth user. One row per auth.users.id.
/// Auth credentials live in Supabase Auth and are never duplicated here (§77).
model Profile {
  /// Supabase Auth user id (auth.users.id).
  userId String @id @map("user_id") @db.Uuid

  /// Playing handicap, e.g. 12.4. Null until the user completes onboarding.
  handicap Decimal? @db.Decimal(4, 1)

  /// Scoring Zone the user defaults to. Fixed at 100 in V1 (kept for a future
  /// configurable zone); never surfaced in onboarding.
  defaultScoringZoneYards Int @default(100) @map("default_scoring_zone_yards")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

/// A private, user-created golf course (§13, §78). No shared/community data in V1.
model GolfCourse {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  name      String
  /// 9 or 18 (validated in the application layer).
  holeCount Int    @map("hole_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  holes   CourseHole[]
  teeSets TeeSet[]
  rounds  Round[]

  @@index([userId, name])
  @@map("golf_courses")
}

/// Par for one hole of a course (§79). Par belongs to the course hole; yardage
/// belongs to the tee/hole combination.
model CourseHole {
  id         String @id @default(uuid()) @db.Uuid
  courseId   String @map("course_id") @db.Uuid
  holeNumber Int    @map("hole_number")
  par        Int

  course      GolfCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teeYardages TeeHoleYardage[]

  @@unique([courseId, holeNumber])
  @@map("course_holes")
}

/// A set of tees for a course, e.g. White / Yellow / Red (§15, §80).
model TeeSet {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  name     String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course   GolfCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  yardages TeeHoleYardage[]
  rounds   Round[]

  @@unique([courseId, name])
  @@map("tee_sets")
}

/// Yardage for one hole from one tee set (§81). Optional in V1.
model TeeHoleYardage {
  id           String @id @default(uuid()) @db.Uuid
  teeSetId     String @map("tee_set_id") @db.Uuid
  courseHoleId String @map("course_hole_id") @db.Uuid
  yardage      Int

  teeSet     TeeSet     @relation(fields: [teeSetId], references: [id], onDelete: Cascade)
  courseHole CourseHole @relation(fields: [courseHoleId], references: [id], onDelete: Cascade)

  @@unique([teeSetId, courseHoleId])
  @@map("tee_hole_yardages")
}

/// §83 — round lifecycle. Closing the app never abandons a round (§19);
/// ABANDONED is always an explicit user action.
enum RoundStatus {
  DRAFT
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED

  @@map("round_status")
}

/// A round of golf (§82). `courseId` / `teeSetId` are nullable and SET NULL on
/// delete so historical rounds survive deletion of the saved course (§91).
/// The round's own snapshot (name, tee, per-hole par/yardage) is authoritative
/// for analysis — saved-course edits never change history (§17).
model Round {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  courseId           String?     @map("course_id") @db.Uuid
  teeSetId           String?     @map("tee_set_id") @db.Uuid
  playedOn           DateTime    @map("played_on") @db.Date
  plannedHoleCount   Int         @map("planned_hole_count")
  completedHoleCount Int         @default(0) @map("completed_hole_count")
  handicapAtStart    Decimal?    @map("handicap_at_start") @db.Decimal(4, 1)
  scoringZoneYards   Int         @map("scoring_zone_yards")
  status             RoundStatus @default(IN_PROGRESS)
  methodologyVersion String      @map("methodology_version")
  version            Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  completedAt        DateTime?   @map("completed_at")

  course   GolfCourse?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teeSet   TeeSet?              @relation(fields: [teeSetId], references: [id], onDelete: SetNull)
  snapshot RoundCourseSnapshot?
  holes    RoundHole[]

  @@index([userId, status])
  @@map("rounds")
}

/// §84 — one per round. Course-level snapshot; hole-level snapshot is on RoundHole.
model RoundCourseSnapshot {
  id         String  @id @default(uuid()) @db.Uuid
  roundId    String  @unique @map("round_id") @db.Uuid
  courseName String  @map("course_name")
  teeName    String? @map("tee_name")

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("round_course_snapshots")
}

/// §85 — one row per played hole. Scoring fields are nullable while the round is
/// in progress. Derived values (shots from zone, score to par, result) are never
/// persisted (§92). `teeOutcome` / `teeLie` / `firstPuttDistance` are stored as
/// strings and mapped to domain enums at the mapper boundary (§101).
model RoundHole {
  id                String   @id @default(uuid()) @db.Uuid
  roundId           String   @map("round_id") @db.Uuid
  holeNumber        Int      @map("hole_number")
  par               Int
  yardage           Int?
  score             Int?
  shotsToZone       Int?     @map("shots_to_zone")
  putts             Int?
  firstPuttDistance String?  @map("first_putt_distance")
  teeOutcome        String?  @map("tee_outcome")
  teeLie            String?  @map("tee_lie")
  bunkerShots       Int      @default(0) @map("bunker_shots")
  bunkersVisited    Int      @default(0) @map("bunkers_visited")
  penaltyStrokes    Int      @default(0) @map("penalty_strokes")
  isComplete        Boolean  @default(false) @map("is_complete")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  version           Int      @default(1)

  round      Round               @relation(fields: [roundId], references: [id], onDelete: Cascade)
  approaches RoundHoleApproach[]

  @@unique([roundId, holeNumber])
  @@map("round_holes")
}

/// §32–35 / §94 — one approach attempt on a hole: a shot from outside the
/// Scoring Zone aiming at the green or zone. Repeatable (a par 5 may have two).
/// `distanceBand` / `result` / `missDirection` are stored as strings and mapped
/// to domain enums at the mapper boundary (§101). `missDirection` is present iff
/// `result` is `missed-zone`.
model RoundHoleApproach {
  id           String  @id @default(uuid()) @db.Uuid
  roundHoleId  String  @map("round_hole_id") @db.Uuid
  /// 1-based order the attempts were played in.
  sequence     Int
  distanceBand String  @map("distance_band")
  result       String
  missDirection String? @map("miss_direction")

  roundHole RoundHole @relation(fields: [roundHoleId], references: [id], onDelete: Cascade)

  @@unique([roundHoleId, sequence])
  @@map("round_hole_approaches")
}
